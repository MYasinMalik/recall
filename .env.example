# Every setting is optional. With nothing set, Recall stores its data in ~/.recall
# and generates its own encryption key there on first run.

# Where the database, uploaded files and the generated key are kept.
RECALL_DATA_DIR=

# 32 random bytes, base64 encoded, used to encrypt sign-in tokens at rest.
# Leave empty to have one generated in the data directory.
RECALL_SECRET=

# Port the app listens on. The sign-in redirect uses the same port.
PORT=

# Test only: point model calls at a stand-in server instead of api.openai.com.
RECALL_API_BASE=
